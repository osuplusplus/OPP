+++ b/scripts/import-partner-tournament.mjs
@@ -0,0 +1,25 @@
+import { readFile } from 'node:fs/promises';
+import { pool } from '../dist/src/db/client.js';
+import { normalizeTournament } from '../dist/src/community-model.js';
+
+const started = Date.now();
+const input = normalizeTournament(JSON.parse(await readFile(process.argv[2], 'utf8')));
+const fields = ['title', 'organizer', 'ruleset', 'summary', 'description', 'requirements', 'poster_url', 'registration_url', 'registration_starts_at', 'registration_ends_at', 'starts_at', 'ends_at'];
+const client = await pool.connect();
+console.log(JSON.stringify({ operation: 'import_partner_tournament', event: 'started', title: input.title }));
+try {
+  await client.query('BEGIN');
+  await client.query('SELECT pg_advisory_xact_lock(hashtext($1))', [`community-partner:${input.registration_url}:${input.title}`]);
+  const existing = await client.query('SELECT id FROM community_tournaments WHERE title=$1 AND registration_url=$2 AND deleted_at IS NULL FOR UPDATE', [input.title, input.registration_url]);
+  if (existing.rows.length > 1) throw new Error('Multiple matching partner announcements; review before importing');
+  const values = fields.map((field) => input[field]);
+  const result = existing.rows.length
+    ? await client.query(`UPDATE community_tournaments SET ${fields.map((field, index) => `${field}=$${index + 2}`).join(',')},updated_at=now() WHERE id=$1 RETURNING id`, [existing.rows[0].id, ...values])
+    : await client.query(`INSERT INTO community_tournaments(${fields.join(',')}) VALUES(${fields.map((_, index) => `$${index + 1}`).join(',')}) RETURNING id`, values);
+  await client.query('COMMIT');
+  console.log(JSON.stringify({ operation: 'import_partner_tournament', event: 'completed', id: result.rows[0].id, updated: existing.rows.length > 0, duration_ms: Date.now() - started }));
+} catch (error) {
+  await client.query('ROLLBACK');
+  console.error(JSON.stringify({ operation: 'import_partner_tournament', event: 'failed', message: error.message }));
+  process.exitCode = 1;
+} finally { client.release(); await pool.end(); }
